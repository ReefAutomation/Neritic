{
  "$schema": "https://renovatebot.com",
  "extends": ["config:recommended"],
  "recreateWhen": "always",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)platformio\\.ini$/"],
      "matchStrings": [
        "platform\\s*=\\s*(?<depName>espressif32)@(?<currentValue>[0-9.]+)"
      ],
      "packageNameTemplate": "platformio/platform-espressif32",
      "datasourceTemplate": "github-releases"
    }
  ]
}
